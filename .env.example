DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
MONGODB_NAME=entr_community
# OSM is fine for local dev. Production uses MapTiler, e.g.
# https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}.png?key=<KEY> (see docs/deployment.md).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Shared cache for rate limits. compose.yaml sets this for the local redis service; unset means per-process LocMem.
# REDIS_URL=redis://redis:6379/0
